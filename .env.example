NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eventflow?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/eventflow?sslmode=require
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@SHADOW_HOST:5432/eventflow_shadow?sslmode=require

# Public URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
QR_SECRET=replace-with-a-long-random-qr-secret

# Google OAuth (Attendee only)
GOOGLE_CLIENT_ID=replace-with-google-client-id

# Seed accounts
SUPER_ADMIN_NAME=EventFlow Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@123
TESTER_ADMIN_NAME=EventFlow Tester Admin
TESTER_ADMIN_EMAIL=admin@example.com
TESTER_ADMIN_PASSWORD=ChangeMe@123

# Redis: use REDIS_URL OR the split values below
REDIS_URL=
REDIS_USER=default
REDIS_PASSWORD=replace-with-redis-password
REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Transactional email (Resend HTTPS API; works on Render free tier)
EMAIL_SENDER=eventflow@example.com
RESEND_API_KEY=replace-with-resend-api-key

# Optional legacy SMTP values (not used by the current email sender)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=

# UddoktaPay
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com
UDDOKTAPAY_API_KEY=replace-with-uddoktapay-api-key

# Commerce rules
RESERVATION_MINUTES=10
SERVICE_FEE_PERCENT=5
PLATFORM_COMMISSION_PERCENT=10
PAYOUT_HOLD_DAYS=7
