{"info":{"_postman_id":"7dac55cf-482b-493d-9167-93a5a1668533","name":"EventFlow API","description":"Postman collection for the currently implemented EventFlow backend endpoints. Import the matching local environment file, run Register Attendee, enter the OTP into the `otp` environment variable, then run Verify Email or Login. Authentication cookies are stored automatically by Postman; bearer-token variables are also saved by the collection scripts.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"variable":[{"key":"baseUrl","value":"http://localhost:5000/api/v1"},{"key":"attendeeEmail","value":"attendee@example.com"},{"key":"attendeePassword","value":"Attendee@123"},{"key":"newPassword","value":"NewPassword@123"},{"key":"otp","value":""},{"key":"googleIdToken","value":""},{"key":"accessToken","value":""},{"key":"refreshToken","value":""},{"key":"adminEmail","value":""},{"key":"adminPassword","value":""},{"key":"adminAccessToken","value":""},{"key":"superAdminEmail","value":""},{"key":"superAdminPassword","value":""},{"key":"superAdminAccessToken","value":""}],"item":[{"name":"System","item":[{"name":"Health Check","request":{"method":"GET","header":[],"url":{"raw":"http://localhost:5000/","host":["http://localhost:5000/"]},"description":"Change the host manually after deployment, or use the Swagger page on the deployed host."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Health check is OK\", function () {","    pm.response.to.have.status(200);","});","const json = pm.response.json();","pm.expect(json.success).to.eql(true);"]}}]}]},{"name":"Auth - Attendee","item":[{"name":"Register Attendee","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/register","host":["{{baseUrl}}/auth/register"]},"description":"After sending, read the OTP from the email and put it into the `otp` variable before running Verify Email.","body":{"mode":"raw","raw":"{\n  \"name\": \"Postman Attendee\",\n  \"email\": \"{{attendeeEmail}}\",\n  \"password\": \"{{attendeePassword}}\",\n  \"attendee\": {\n    \"phone\": \"01700000000\",\n    \"location\": \"Chattogram\"\n  }\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Registration request accepted\", function () {","    pm.response.to.have.status(201);","});","const json = pm.response.json();","pm.expect(json.success).to.eql(true);","pm.expect(json.message).to.eql(\"Verification OTP Sent\");"]}}]},{"name":"Verify Email","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/verify-email","host":["{{baseUrl}}/auth/verify-email"]},"body":{"mode":"raw","raw":"{\n  \"email\": \"{{attendeeEmail}}\",\n  \"otp\": \"{{otp}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Authentication response succeeded\", function () {","    pm.expect(pm.response.code).to.be.oneOf([200, 201]);","});","const json = pm.response.json();","if (json?.data?.accessToken) {","    pm.collectionVariables.set(\"accessToken\", json.data.accessToken);","}","if (json?.data?.refreshToken) {","    pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);","}"]}}]},{"name":"Attendee Login","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/login","host":["{{baseUrl}}/auth/login"]},"body":{"mode":"raw","raw":"{\n  \"email\": \"{{attendeeEmail}}\",\n  \"password\": \"{{attendeePassword}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Authentication response succeeded\", function () {","    pm.expect(pm.response.code).to.be.oneOf([200, 201]);","});","const json = pm.response.json();","if (json?.data?.accessToken) {","    pm.collectionVariables.set(\"accessToken\", json.data.accessToken);","}","if (json?.data?.refreshToken) {","    pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);","}"]}}]},{"name":"Get Me","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/auth/me","host":["{{baseUrl}}/auth/me"]},"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Authenticated profile returned\", function () {","    pm.response.to.have.status(200);","});","const json = pm.response.json();","pm.expect(json.success).to.eql(true);"]}}]},{"name":"Refresh Token","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/refresh-token","host":["{{baseUrl}}/auth/refresh-token"]},"description":"Requires the refreshToken cookie. Postman normally keeps it automatically after Login or Verify Email."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Refresh endpoint completed\", function () {","    pm.expect(pm.response.code).to.be.oneOf([200, 401, 500]);","});"]}}]},{"name":"Google Login","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/google","host":["{{baseUrl}}/auth/google"]},"description":"Requires a real Google ID token for the configured GOOGLE_CLIENT_ID.","body":{"mode":"raw","raw":"{\n  \"idToken\": \"{{googleIdToken}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Authentication response succeeded\", function () {","    pm.expect(pm.response.code).to.be.oneOf([200, 201]);","});","const json = pm.response.json();","if (json?.data?.accessToken) {","    pm.collectionVariables.set(\"accessToken\", json.data.accessToken);","}","if (json?.data?.refreshToken) {","    pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);","}"]}}]},{"name":"Forgot Password","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/forgot-password","host":["{{baseUrl}}/auth/forgot-password"]},"description":"Read the reset OTP from email and update the `otp` variable.","body":{"mode":"raw","raw":"{\n  \"email\": \"{{attendeeEmail}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Response is JSON\", function () {","    pm.response.to.be.json;","});","pm.test(\"Response completed\", function () {","    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 404, 409, 500]);","});"]}}]},{"name":"Reset Password","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/reset-password","host":["{{baseUrl}}/auth/reset-password"]},"description":"After a successful reset, update attendeePassword if you want later login requests to use the new password.","body":{"mode":"raw","raw":"{\n  \"email\": \"{{attendeeEmail}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"otp\": \"{{otp}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Response is JSON\", function () {","    pm.response.to.be.json;","});","pm.test(\"Response completed\", function () {","    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 404, 409, 500]);","});"]}}]}]},{"name":"Auth - Seeded Admins","item":[{"name":"Admin Login","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/login","host":["{{baseUrl}}/auth/login"]},"description":"Use the tester/admin credentials configured in your EventFlow environment.","body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Admin login succeeded\", function () {","    pm.expect(pm.response.code).to.eql(200);","});","const json = pm.response.json();","if (json?.data?.accessToken) {","    pm.collectionVariables.set(\"adminAccessToken\", json.data.accessToken);","}"]}}]},{"name":"Super Admin Login","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/auth/login","host":["{{baseUrl}}/auth/login"]},"description":"Use the seeded Super Admin credentials configured in your EventFlow environment.","body":{"mode":"raw","raw":"{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Super Admin login succeeded\", function () {","    pm.expect(pm.response.code).to.eql(200);","});","const json = pm.response.json();","if (json?.data?.accessToken) {","    pm.collectionVariables.set(\"superAdminAccessToken\", json.data.accessToken);","}"]}}]}]},{"name":"User","item":[{"name":"Upload Profile Image","request":{"method":"PATCH","header":[],"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},"body":{"mode":"formdata","formdata":[{"key":"profileImage","type":"file","src":[],"description":"Select an image file manually in Postman."}]},"url":{"raw":"{{baseUrl}}/user/profile-image","host":["{{baseUrl}}"],"path":["user","profile-image"]},"description":"Choose a local image file for the `profileImage` field before sending."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Profile image endpoint completed\", function () {","    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403, 500]);","});"]}}]}]}]}