model Refund {
  id String @id @default(cuid())

  orderId String
  order   Order @relation(fields: [orderId], references: [id])

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  eventId    String
  attendeeId String

  status RefundStatus @default(REQUESTED)

  reason          String
  requestedAmount Decimal @db.Decimal(12, 2)
  approvedAmount  Decimal? @db.Decimal(12, 2)

  decisionByUserId String?
  decisionReason   String?

  gatewayRefundId String?
  refundedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([orderId, status])
}

model Dispute {
  id String @id @default(cuid())

  attendeeId String
  attendee   Attendee @relation(fields: [attendeeId], references: [id])

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  orderId String
  order   Order @relation(fields: [orderId], references: [id])

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  organizerId String

  reason       String
  description  String
  evidenceUrls String[] @default([])

  status DisputeStatus @default(OPEN)

  organizerResponse String?
  adminDecision     String?
  decisionByUserId  String?
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages DisputeMessage[]

  @@index([status, createdAt])
  @@index([organizerId, status])
}

model DisputeMessage {
  id String @id @default(cuid())

  disputeId String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  senderUserId String
  message      String

  createdAt DateTime @default(now())
}

model Payout {
  id String @id @default(cuid())

  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id])

  eventId String @unique
  event   Event @relation(fields: [eventId], references: [id])

  grossRevenue       Decimal @db.Decimal(12, 2)
  refundAmount       Decimal @default(0) @db.Decimal(12, 2)
  gatewayFees        Decimal @default(0) @db.Decimal(12, 2)
  platformCommission Decimal @default(0) @db.Decimal(12, 2)
  adjustments        Decimal @default(0) @db.Decimal(12, 2)
  netAmount          Decimal @db.Decimal(12, 2)

  status PayoutStatus @default(PENDING)

  requestedAt      DateTime?
  processedAt      DateTime?
  paidAt           DateTime?
  paymentReference String?
  holdReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId, status])
}
