<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>EventFlow Password Reset</title>
</head>

<body
	style="
		margin: 0;
		padding: 0;
		background-color: #f5f6fb;
		font-family: Arial, Helvetica, sans-serif;
		color: #111827;
	"
>
	<table
		role="presentation"
		width="100%"
		cellspacing="0"
		cellpadding="0"
		border="0"
		style="
			width: 100%;
			background-color: #f5f6fb;
			padding: 40px 16px;
		"
	>
		<tr>
			<td align="center">

				<table
					role="presentation"
					width="600"
					cellspacing="0"
					cellpadding="0"
					border="0"
					style="
						width: 100%;
						max-width: 600px;
						background-color: #ffffff;
						border-radius: 20px;
						overflow: hidden;
						box-shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
					"
				>

					<tr>
						<td
							style="
								background-color: #111827;
								padding: 36px 40px;
								text-align: center;
							"
						>
							<div
								style="
									font-size: 30px;
									font-weight: 700;
									color: #ffffff;
									letter-spacing: -0.5px;
								"
							>
								Event<span style="color: #818cf8;">Flow</span>
							</div>

							<p
								style="
									margin: 8px 0 0;
									font-size: 14px;
									color: #cbd5e1;
								"
							>
								Secure Event Management & Ticketing
							</p>
						</td>
					</tr>

					<tr>
						<td style="padding: 42px 40px 20px;">

							<p
								style="
									margin: 0 0 12px;
									font-size: 15px;
									color: #64748b;
								"
							>
								Hello <strong><%= name %></strong>,
							</p>

							<h1
								style="
									margin: 0 0 16px;
									font-size: 28px;
									line-height: 36px;
									font-weight: 700;
									color: #0f172a;
								"
							>
								Reset your password
							</h1>

							<p
								style="
									margin: 0;
									font-size: 16px;
									line-height: 26px;
									color: #475569;
								"
							>
								We received a request to reset the password
								for your EventFlow account. Use the verification
								code below to continue.
							</p>

						</td>
					</tr>

					<tr>
						<td style="padding: 12px 40px 30px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #f5f3ff;
									border: 1px solid #ddd6fe;
									border-radius: 14px;
								"
							>
								<tr>
									<td
										align="center"
										style="padding: 30px 20px;"
									>
										<p
											style="
												margin: 0 0 12px;
												font-size: 12px;
												font-weight: 700;
												letter-spacing: 1.5px;
												text-transform: uppercase;
												color: #7c3aed;
											"
										>
											Your verification code
										</p>

										<div
											style="
												font-size: 40px;
												line-height: 50px;
												font-weight: 700;
												letter-spacing: 10px;
												color: #312e81;
											"
										>
											<%= otp %>
										</div>

										<p
											style="
												margin: 12px 0 0;
												font-size: 13px;
												line-height: 20px;
												color: #6d28d9;
											"
										>
											This code expires in
											<strong>
												<%= expirationMinutes %> minutes
											</strong>.
										</p>
									</td>
								</tr>
							</table>

						</td>
					</tr>

					<tr>
						<td style="padding: 0 40px 30px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #f8fafc;
									border-left: 4px solid #6366f1;
									border-radius: 8px;
								"
							>
								<tr>
									<td style="padding: 17px 18px;">
										<p
											style="
												margin: 0 0 6px;
												font-size: 14px;
												font-weight: 700;
												color: #1e293b;
											"
										>
											🔐 Security notice
										</p>

										<p
											style="
												margin: 0;
												font-size: 13px;
												line-height: 21px;
												color: #64748b;
											"
										>
											Never share this OTP with anyone.
											EventFlow will never ask for your password
											or verification code through a phone call
											or message.
										</p>
									</td>
								</tr>
							</table>

						</td>
					</tr>

					<tr>
						<td style="padding: 0 40px 40px;">

							<p
								style="
									margin: 0;
									font-size: 14px;
									line-height: 23px;
									color: #64748b;
								"
							>
								If you did not request a password reset,
								you can safely ignore this email.
								Your current password will remain unchanged.
							</p>

							<p
								style="
									margin: 28px 0 0;
									font-size: 14px;
									line-height: 22px;
									color: #475569;
								"
							>
								Regards,<br />
								<strong style="color: #0f172a;">
									The EventFlow Team
								</strong>
							</p>

						</td>
					</tr>

					<tr>
						<td
							style="
								background-color: #f8fafc;
								border-top: 1px solid #e2e8f0;
								padding: 24px 40px;
								text-align: center;
							"
						>
							<p
								style="
									margin: 0 0 6px;
									font-size: 12px;
									line-height: 18px;
									color: #94a3b8;
								"
							>
								This is an automated security email.
								Please do not reply.
							</p>

							<p
								style="
									margin: 0;
									font-size: 12px;
									color: #94a3b8;
								"
							>
								© <%= year %> EventFlow.
								All rights reserved.
							</p>
						</td>
					</tr>

				</table>

				<p
					style="
						margin: 22px 0 0;
						font-size: 12px;
						color: #94a3b8;
					"
				>
					Secure events. Seamless experiences.
				</p>

			</td>
		</tr>
	</table>
</body>
</html>