<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title><%= heading %></title>
</head>
<body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    <%= preheader %>
  </div>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#f4f7fb;">
    <tr>
      <td align="center" style="padding:36px 16px;">
        <table role="presentation" width="620" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:620px;background:#ffffff;border-radius:22px;overflow:hidden;box-shadow:0 20px 50px rgba(15,23,42,0.10);">
          <tr>
            <td style="padding:0;background:#111827;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td style="padding:28px 34px;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                      <tr>
                        <td width="46" height="46" align="center" valign="middle" style="width:46px;height:46px;background:#ffffff;border-radius:14px;font-size:18px;font-weight:800;color:#111827;">
                          EF
                        </td>
                        <td style="padding-left:14px;">
                          <div style="font-size:24px;line-height:28px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;">
                            Event<span style="color:#a78bfa;">Flow</span>
                          </div>
                          <div style="margin-top:4px;font-size:12px;line-height:18px;color:#cbd5e1;">
                            Events, tickets and experiences — simplified.
                          </div>
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td align="right" valign="middle" style="padding:28px 34px 28px 0;">
                    <span style="display:inline-block;padding:8px 12px;border:1px solid #374151;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:#c4b5fd;">
                      Secure verification
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:42px 40px 14px;">
              <div style="font-size:14px;line-height:22px;color:#64748b;">
                Hello <strong style="color:#334155;"><%= name %></strong>,
              </div>

              <h1 style="margin:12px 0 14px;font-size:30px;line-height:38px;font-weight:800;letter-spacing:-0.7px;color:#0f172a;">
                <%= heading %>
              </h1>

              <p style="margin:0;font-size:16px;line-height:26px;color:#475569;">
                <%= message %>
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:18px 40px 26px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f7f5ff;border:1px solid #e9e5ff;border-radius:18px;">
                <tr>
                  <td align="center" style="padding:28px 20px 26px;">
                    <div style="font-size:11px;line-height:18px;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:#7c3aed;">
                      Your verification code
                    </div>

                    <div style="margin-top:12px;font-family:'Courier New',Courier,monospace;font-size:42px;line-height:50px;font-weight:800;letter-spacing:11px;color:#312e81;">
                      <%= otp %>
                    </div>

                    <div style="margin-top:12px;font-size:13px;line-height:20px;color:#6d28d9;">
                      Valid for <strong><%= expirationMinutes %> minutes</strong>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:0 40px 26px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;">
                <tr>
                  <td width="46" valign="top" style="padding:18px 0 18px 18px;font-size:22px;">
                    🔐
                  </td>
                  <td style="padding:18px 18px 18px 8px;">
                    <div style="font-size:14px;line-height:20px;font-weight:800;color:#1e293b;">
                      Keep this code private
                    </div>
                    <div style="margin-top:5px;font-size:13px;line-height:21px;color:#64748b;">
                      Never share this code with anyone. EventFlow will never ask you for your password or verification code by phone, chat, or social media.
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:0 40px 40px;">
              <p style="margin:0;font-size:14px;line-height:23px;color:#64748b;">
                If you did not request this verification, you can safely ignore this email. No account action will be completed without the correct code.
              </p>

              <p style="margin:26px 0 0;font-size:14px;line-height:22px;color:#475569;">
                See you at the next great event,<br />
                <strong style="color:#0f172a;">The EventFlow Team</strong>
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:22px 40px;background:#f8fafc;border-top:1px solid #e2e8f0;text-align:center;">
              <p style="margin:0 0 6px;font-size:12px;line-height:18px;color:#94a3b8;">
                This is an automated security message from EventFlow.
              </p>
              <p style="margin:0;font-size:12px;line-height:18px;color:#94a3b8;">
                © <%= year %> EventFlow. All rights reserved.
              </p>
            </td>
          </tr>
        </table>

        <p style="margin:18px 0 0;font-size:12px;line-height:18px;color:#94a3b8;">
          Secure events. Seamless experiences.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
