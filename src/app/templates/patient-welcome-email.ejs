<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta
		name="viewport"
		content="width=device-width, initial-scale=1.0"
	/>
	<title>Welcome to EventFlow</title>
</head>

<body
	style="
		margin: 0;
		padding: 0;
		background-color: #f5f6fb;
		font-family: Arial, Helvetica, sans-serif;
		color: #111827;
	"
>
	<table
		role="presentation"
		width="100%"
		cellspacing="0"
		cellpadding="0"
		border="0"
		style="
			width: 100%;
			background-color: #f5f6fb;
			padding: 40px 16px;
		"
	>
		<tr>
			<td align="center">

				<table
					role="presentation"
					width="600"
					cellspacing="0"
					cellpadding="0"
					border="0"
					style="
						width: 100%;
						max-width: 600px;
						background-color: #ffffff;
						border-radius: 20px;
						overflow: hidden;
						box-shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
					"
				>

					<!-- Header -->
					<tr>
						<td
							style="
								background-color: #111827;
								padding: 36px 40px;
								text-align: center;
							"
						>
							<div
								style="
									font-size: 30px;
									font-weight: 700;
									color: #ffffff;
									letter-spacing: -0.5px;
								"
							>
								Event<span style="color: #818cf8;">Flow</span>
							</div>

							<p
								style="
									margin: 8px 0 0;
									font-size: 14px;
									line-height: 22px;
									color: #cbd5e1;
								"
							>
								Discover events. Create memories.
							</p>
						</td>
					</tr>

					<!-- Main -->
					<tr>
						<td style="padding: 42px 40px 20px;">

							<p
								style="
									margin: 0 0 12px;
									font-size: 15px;
									color: #64748b;
								"
							>
								Hello <strong><%= name %></strong>,
							</p>

							<h1
								style="
									margin: 0 0 16px;
									font-size: 28px;
									line-height: 36px;
									font-weight: 700;
									color: #0f172a;
								"
							>
								Welcome to EventFlow 🎉
							</h1>

							<p
								style="
									margin: 0;
									font-size: 16px;
									line-height: 26px;
									color: #475569;
								"
							>
								Your email has been successfully verified and
								your EventFlow attendee account is now active.
								You're ready to discover and experience amazing events.
							</p>

						</td>
					</tr>

					<!-- Verification -->
					<tr>
						<td style="padding: 12px 40px 28px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #ecfdf5;
									border: 1px solid #a7f3d0;
									border-radius: 14px;
								"
							>
								<tr>
									<td
										align="center"
										style="padding: 28px 20px;"
									>
										<div
											style="
												width: 54px;
												height: 54px;
												line-height: 54px;
												margin: 0 auto 14px;
												background-color: #059669;
												border-radius: 50%;
												color: #ffffff;
												font-size: 28px;
												font-weight: 700;
												text-align: center;
											"
										>
											✓
										</div>

										<p
											style="
												margin: 0 0 7px;
												font-size: 18px;
												font-weight: 700;
												color: #065f46;
											"
										>
											Account verified successfully
										</p>

										<p
											style="
												margin: 0;
												font-size: 14px;
												line-height: 22px;
												color: #047857;
											"
										>
											Your EventFlow attendee account is ready.
										</p>
									</td>
								</tr>
							</table>

						</td>
					</tr>

					<!-- Features -->
					<tr>
						<td style="padding: 0 40px 30px;">

							<p
								style="
									margin: 0 0 16px;
									font-size: 17px;
									font-weight: 700;
									color: #1e293b;
								"
							>
								What's waiting for you
							</p>

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
							>

								<tr>
									<td
										style="
											padding: 14px 16px;
											background-color: #f8fafc;
											border-radius: 10px;
										"
									>
										<p
											style="
												margin: 0;
												font-size: 14px;
												line-height: 23px;
												color: #475569;
											"
										>
											🎟️ <strong>Discover events</strong>
											and find experiences that interest you.
										</p>
									</td>
								</tr>

								<tr>
									<td style="height: 10px;"></td>
								</tr>

								<tr>
									<td
										style="
											padding: 14px 16px;
											background-color: #f8fafc;
											border-radius: 10px;
										"
									>
										<p
											style="
												margin: 0;
												font-size: 14px;
												line-height: 23px;
												color: #475569;
											"
										>
											📱 <strong>Manage your tickets</strong>
											and keep your event access organized.
										</p>
									</td>
								</tr>

								<tr>
									<td style="height: 10px;"></td>
								</tr>

								<tr>
									<td
										style="
											padding: 14px 16px;
											background-color: #f8fafc;
											border-radius: 10px;
										"
									>
										<p
											style="
												margin: 0;
												font-size: 14px;
												line-height: 23px;
												color: #475569;
											"
										>
											⚡ <strong>Enjoy seamless access</strong>
											with secure digital ticketing and event experiences.
										</p>
									</td>
								</tr>

							</table>

						</td>
					</tr>

					<!-- Security -->
					<tr>
						<td style="padding: 0 40px 36px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #f5f3ff;
									border-left: 4px solid #6366f1;
									border-radius: 8px;
								"
							>
								<tr>
									<td style="padding: 17px 18px;">

										<p
											style="
												margin: 0 0 6px;
												font-size: 14px;
												font-weight: 700;
												color: #312e81;
											"
										>
											🔐 Protect your EventFlow account
										</p>

										<p
											style="
												margin: 0;
												font-size: 13px;
												line-height: 21px;
												color: #645f8f;
											"
										>
											Keep your password private and never
											share verification codes with anyone.
											EventFlow will never ask for your password
											through email, messages, or phone calls.
										</p>

									</td>
								</tr>
							</table>

						</td>
					</tr>

					<!-- Closing -->
					<tr>
						<td style="padding: 0 40px 40px;">

							<p
								style="
									margin: 0;
									font-size: 14px;
									line-height: 23px;
									color: #64748b;
								"
							>
								We're excited to have you in the EventFlow community.
								Your next great event experience is just beginning.
							</p>

							<p
								style="
									margin: 26px 0 0;
									font-size: 14px;
									line-height: 22px;
									color: #475569;
								"
							>
								Regards,<br />
								<strong style="color: #0f172a;">
									The EventFlow Team
								</strong>
							</p>

						</td>
					</tr>

					<!-- Footer -->
					<tr>
						<td
							style="
								background-color: #f8fafc;
								border-top: 1px solid #e2e8f0;
								padding: 24px 40px;
								text-align: center;
							"
						>
							<p
								style="
									margin: 0 0 6px;
									font-size: 12px;
									line-height: 18px;
									color: #94a3b8;
								"
							>
								This is an automated EventFlow email.
								Please do not reply.
							</p>

							<p
								style="
									margin: 0;
									font-size: 12px;
									color: #94a3b8;
								"
							>
								© <%= year %> EventFlow.
								All rights reserved.
							</p>
						</td>
					</tr>

				</table>

				<p
					style="
						margin: 22px 0 0;
						font-size: 12px;
						color: #94a3b8;
					"
				>
					Secure events. Seamless experiences.
				</p>

			</td>
		</tr>
	</table>
</body>
</html>