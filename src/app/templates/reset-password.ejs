<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>EventFlow Password Changed</title>
</head>

<body
	style="
		margin: 0;
		padding: 0;
		background-color: #f5f6fb;
		font-family: Arial, Helvetica, sans-serif;
		color: #111827;
	"
>
	<table
		role="presentation"
		width="100%"
		cellspacing="0"
		cellpadding="0"
		border="0"
		style="
			width: 100%;
			background-color: #f5f6fb;
			padding: 40px 16px;
		"
	>
		<tr>
			<td align="center">

				<table
					role="presentation"
					width="600"
					cellspacing="0"
					cellpadding="0"
					border="0"
					style="
						width: 100%;
						max-width: 600px;
						background-color: #ffffff;
						border-radius: 20px;
						overflow: hidden;
						box-shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
					"
				>

					<tr>
						<td
							style="
								background-color: #111827;
								padding: 36px 40px;
								text-align: center;
							"
						>
							<div
								style="
									font-size: 30px;
									font-weight: 700;
									color: #ffffff;
									letter-spacing: -0.5px;
								"
							>
								Event<span style="color: #818cf8;">Flow</span>
							</div>

							<p
								style="
									margin: 8px 0 0;
									font-size: 14px;
									color: #cbd5e1;
								"
							>
								Account Security Notification
							</p>
						</td>
					</tr>

					<tr>
						<td style="padding: 42px 40px 20px;">

							<p
								style="
									margin: 0 0 12px;
									font-size: 15px;
									color: #64748b;
								"
							>
								Hello <strong><%= name %></strong>,
							</p>

							<h1
								style="
									margin: 0 0 16px;
									font-size: 28px;
									line-height: 36px;
									font-weight: 700;
									color: #0f172a;
								"
							>
								Your password has been changed
							</h1>

							<p
								style="
									margin: 0;
									font-size: 16px;
									line-height: 26px;
									color: #475569;
								"
							>
								This email confirms that your EventFlow
								account password was successfully updated.
							</p>

						</td>
					</tr>

					<tr>
						<td style="padding: 12px 40px 28px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #ecfdf5;
									border: 1px solid #a7f3d0;
									border-radius: 14px;
								"
							>
								<tr>
									<td
										align="center"
										style="padding: 30px 20px;"
									>

										<div
											style="
												width: 54px;
												height: 54px;
												line-height: 54px;
												margin: 0 auto 14px;
												background-color: #059669;
												border-radius: 50%;
												color: #ffffff;
												font-size: 28px;
												font-weight: 700;
												text-align: center;
											"
										>
											✓
										</div>

										<p
											style="
												margin: 0 0 7px;
												font-size: 18px;
												font-weight: 700;
												color: #065f46;
											"
										>
											Password updated successfully
										</p>

										<p
											style="
												margin: 0;
												font-size: 14px;
												line-height: 22px;
												color: #047857;
											"
										>
											You can now sign in to EventFlow
											using your new password.
										</p>

									</td>
								</tr>
							</table>

						</td>
					</tr>

					<tr>
						<td style="padding: 0 40px 28px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #f8fafc;
									border-radius: 12px;
								"
							>
								<tr>
									<td style="padding: 18px 20px;">

										<p
											style="
												margin: 0 0 7px;
												font-size: 12px;
												font-weight: 700;
												letter-spacing: 1px;
												text-transform: uppercase;
												color: #94a3b8;
											"
										>
											Account
										</p>

										<p
											style="
												margin: 0;
												font-size: 14px;
												color: #334155;
											"
										>
											<%= email %>
										</p>

									</td>
								</tr>
							</table>

						</td>
					</tr>

					<tr>
						<td style="padding: 0 40px 30px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #fff7ed;
									border-left: 4px solid #f97316;
									border-radius: 8px;
								"
							>
								<tr>
									<td style="padding: 17px 18px;">

										<p
											style="
												margin: 0 0 6px;
												font-size: 14px;
												font-weight: 700;
												color: #9a3412;
											"
										>
											⚠️ Didn't make this change?
										</p>

										<p
											style="
												margin: 0;
												font-size: 13px;
												line-height: 21px;
												color: #9a3412;
											"
										>
											If you did not change your password,
											your account may be at risk.
											Reset your password immediately and
											contact EventFlow support.
										</p>

									</td>
								</tr>
							</table>

						</td>
					</tr>

					<tr>
						<td style="padding: 0 40px 40px;">

							<p
								style="
									margin: 0 0 12px;
									font-size: 14px;
									font-weight: 700;
									color: #1e293b;
								"
							>
								🔐 Keep your account secure
							</p>

							<p
								style="
									margin: 0;
									font-size: 14px;
									line-height: 24px;
									color: #64748b;
								"
							>
								• Never share your password or OTP.<br />
								• Use a unique password for EventFlow.<br />
								• Avoid reusing passwords from other services.<br />
								• Sign out from devices you no longer use.
							</p>

							<p
								style="
									margin: 28px 0 0;
									font-size: 14px;
									line-height: 22px;
									color: #475569;
								"
							>
								Regards,<br />
								<strong style="color: #0f172a;">
									The EventFlow Team
								</strong>
							</p>

						</td>
					</tr>

					<tr>
						<td
							style="
								background-color: #f8fafc;
								border-top: 1px solid #e2e8f0;
								padding: 24px 40px;
								text-align: center;
							"
						>
							<p
								style="
									margin: 0 0 6px;
									font-size: 12px;
									line-height: 18px;
									color: #94a3b8;
								"
							>
								This is an automated EventFlow security
								notification. Please do not reply.
							</p>

							<p
								style="
									margin: 0;
									font-size: 12px;
									color: #94a3b8;
								"
							>
								© <%= year %> EventFlow.
								All rights reserved.
							</p>
						</td>
					</tr>

				</table>

				<p
					style="
						margin: 22px 0 0;
						font-size: 12px;
						color: #94a3b8;
					"
				>
					Secure events. Seamless experiences.
				</p>

			</td>
		</tr>
	</table>
</body>
</html>